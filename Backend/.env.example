# =============================================================================
# IMMUNE-NET environment configuration template
# Copy this file to `.env` and fill in real values before first run.
# -----------------------------------------------------------------------------
# ALLY — Optional: IBM watsonx.ai integration for Granite-powered briefings.
# When WATSONX_API_KEY / WATSONX_PROJECT_ID are missing the system runs in
# OFFLINE mode and uses the deterministic rule-based BLUF generator.
# The demo never breaks without credentials.
# =============================================================================

# -- Orchestrator -------------------------------------------------------------
# Number of simulated nodes that register with the orchestrator.
INITIAL_AGENT_COUNT=8

# WebSocket broadcast channel the frontend subscribes to.
WS_CHANNEL=immune-net

# -- IBM watsonx.ai (optional) -------------------------------------------------
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# -- Demo / Simulation ----------------------------------------------------------
# Base URL of the demo driver (bob-ai-hackathon-404-founder-Backend/demo.py).
DEMO_API_URL=http://localhost:8000
# Base URL of the web UI to open for the operator.
FRONTEND_URL=http://localhost:5173

# Local telemetry finger-printing engine (agent side).
EBPF_MODE=simulated